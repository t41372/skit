
reference

# Python scripts are supported inputs. Ignore only their generated cache files.
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/

# Rust
/target/
*.profraw
lcov.info

# Claude Code session-local state (worktrees and task metadata) is temporary.
# It is not product source and must not enter repository checks.
.claude/

# Agent handoff notes are local and temporary.
/CLAUDE_HANDOFF.md

# Test / coverage artifacts
mutants/
mutants.out/
mutants.out.old/

# Benchmark pipeline artifacts (results are CI artifacts, never committed)
.bench/

# Environment variables
.env*.local

# OS
.DS_Store

# Demo videos are uploaded to GitHub user-attachments, not hotlinked from the
# repo like the PNGs — keeping them out of git stops history from ballooning.
docs/assets/demo-*.mp4
