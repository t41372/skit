{
  "name": "skit-docs",
  "version": "0.0.7",
  "private": true,
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=12.2.2"
  },
  "scripts": {
    "predev": "node scripts/sync-readme.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-readme.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-links.mjs && node scripts/check-contracts.mjs",
    "check-links": "node scripts/check-links.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "cnfast": "^0.2.0",
    "fumadocs-core": "16.18.3",
    "fumadocs-mdx": "15.5.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.3",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "serve": "^14.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "serve": {
      "compression": "^1.8.2"
    }
  }
}
