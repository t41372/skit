{
  "name": "skit-docs",
  "version": "0.0.7",
  "private": true,
  "engines": {
    "node": ">=26.7.0",
    "npm": ">=12.0.2"
  },
  "scripts": {
    "predev": "node scripts/sync-readme.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-readme.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-links.mjs && node scripts/check-contracts.mjs",
    "check-links": "node scripts/check-links.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.14.2",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.2",
    "lucide-react": "^1.27.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
